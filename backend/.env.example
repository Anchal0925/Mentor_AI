# Core PostgreSQL (asyncpg — used by MentorMind core, behavior, grok, postgre)
DATABASE_URL=postgresql+asyncpg://postgres:postgre123@localhost:5432/mentormind

# Onboarding module (sync SQLAlchemy — defaults to SQLite if not set)
# Set this to the same postgres URL but with psycopg2/psycopg driver to use PG
# ONBOARDING_DATABASE_URL=postgresql://postgres:postgre123@localhost:5432/mentormind
# Leave unset to use SQLite (hindsight.db) — fine for dev
